From 3e4bcf764b565ce4193646de1f6328f734ff7bbb Mon Sep 17 00:00:00 2001
From: Zhijun You <hujy652@gmail.com>
Date: Tue, 25 May 2021 13:22:41 +0800
Subject: [PATCH] ath10k: switch to ieee80211_tx_status_ext()

Makes station look up faster?

Signed-off-by: Zhijun You <hujy652@gmail.com>
---
 drivers/net/wireless/ath/ath10k/txrx.c | 13 ++++++-------
 1 file changed, 6 insertions(+), 7 deletions(-)

--- a/drivers/net/wireless/ath/ath10k/txrx.c
+++ b/drivers/net/wireless/ath/ath10k/txrx.c
@@ -51,7 +51,9 @@ int ath10k_txrx_tx_unref(struct ath10k_h
 	struct ath10k_txq *artxq;
 	struct sk_buff *msdu;
 	u8 flags;
-	struct ieee80211_vif *vif;
+	struct ieee80211_tx_status status = {
+		.sta = NULL,
+	};
 
 	ath10k_dbg(ar, ATH10K_DBG_HTT,
 		   "htt tx completion msdu_id %u status %d\n",
@@ -81,8 +83,6 @@ int ath10k_txrx_tx_unref(struct ath10k_h
 	}
 
 	flags = skb_cb->flags;
-	vif = skb_cb->vif;
-
 	ath10k_htt_tx_free_msdu_id(htt, tx_done->msdu_id);
 	ath10k_htt_tx_dec_pending(htt);
 	spin_unlock_bh(&htt->tx_lock);
@@ -131,10 +131,14 @@ int ath10k_txrx_tx_unref(struct ath10k_h
 		info->status.is_valid_ack_signal = true;
 	}
 
-	if (info->flags & IEEE80211_TX_CTL_HW_80211_ENCAP)
-		ieee80211_tx_status_8023(ar->hw, vif, msdu);
-	else
-		ieee80211_tx_status(ar->hw, msdu);
+	rcu_read_lock();
+	if (txq && txq->sta)
+		status.sta = txq->sta;
+	status.skb = msdu;
+	status.info = info;
+	rcu_read_unlock();
+
+	ieee80211_tx_status_ext(ar->hw, &status);
 	/* we do not own the msdu anymore */
 
 	return 0;
--- a/drivers/net/wireless/ath/ath10k/htt_rx.c
+++ b/drivers/net/wireless/ath/ath10k/htt_rx.c
@@ -1942,7 +1942,8 @@ static void ath10k_htt_rx_h_mpdu(struct
 			status->flag |= RX_FLAG_MIC_STRIPPED |
 					RX_FLAG_ICV_STRIPPED;
 		else
-			status->flag |= RX_FLAG_IV_STRIPPED;
+			status->flag |= RX_FLAG_IV_STRIPPED |
+					RX_FLAG_PN_VALIDATED;
 	}
 
 	skb_queue_walk(amsdu, msdu) {
